{:version "1.0",
 :title "Bioinformatics Tools Domain Schema",
 :kinds
 {:MaturityStatus
  {:doc "The development or support stage of a tool",
   :fields
   {:name
    {:type :string,
     :doc "Name of the maturity status",
     :unique? true,
     :examples ["Stable" "Beta" "Deprecated"]},
    :description
    {:type :string, :doc "Description of what this status implies"},
    :actively-supported?
    {:type :boolean,
     :doc "Whether the status implies ongoing support"}}},
  :QualityMetric
  {:doc "A measure of tool or data performance and reliability",
   :fields
   {:name
    {:type :string,
     :doc "Name of the quality metric",
     :examples ["Precision" "Recall" "F1 Score"]},
    :value {:type :double, :doc "Numeric value of the metric"},
    :unit
    {:type :MeasurementUnit,
     :doc "Unit of measurement for this metric"},
    :description
    {:type :string, :doc "Explanation of what the metric measures"}}},
  :Taxon
  {:doc "A taxonomic classification unit",
   :fields
   {:name
    {:type :string,
     :doc "Scientific name of the taxon",
     :examples ["Homo sapiens" "Escherichia coli" "Mus musculus"]},
    :rank {:type :taxonomic-rank-enum, :doc "Taxonomic rank"},
    :ncbi-taxon-id
    {:type :Identifier, :doc "NCBI Taxonomy identifier"},
    :parent {:type :Taxon, :doc "Parent taxon in the hierarchy"},
    :common-name
    {:type :string,
     :doc "Common name",
     :examples ["Human" "Mouse" "Fruit fly"]}},
   :icon "🌳"},
  :FileFormat
  {:doc "A specification for structuring biological data files",
   :fields
   {:name
    {:type :string,
     :doc "Name of the file format",
     :unique? true,
     :examples ["FASTA" "FASTQ" "VCF"]},
    :extension
    {:type :string,
     :doc "File extension(s)",
     :cardinality :many,
     :examples [".fasta" ".fastq" ".vcf"]},
    :media-type
    {:type :string,
     :doc "MIME media type",
     :examples ["text/x-fasta" "application/octet-stream"]},
    :binary? {:type :boolean, :doc "Whether the format is binary"},
    :specification-url
    {:type :string, :doc "URL to the format specification"},
    :data-standard
    {:type :DataStandard, :doc "Associated data standard"}},
   :icon "📄"},
  :DataRepository
  {:doc "A storage system for biological datasets",
   :fields
   {:name
    {:type :string,
     :doc "Name of the data repository",
     :unique? true,
     :examples ["NCBI SRA" "EMBL-EBI ENA" "Zenodo"]},
    :url {:type :string, :doc "URL of the repository"},
    :maintained-by
    {:type :Organization,
     :doc "Organization that maintains the repository"},
    :access-mode
    {:type :AccessMode,
     :cardinality :many,
     :doc "Available access modes"},
    :datasets
    {:type :Dataset,
     :cardinality :many,
     :doc "Datasets hosted in the repository"}},
   :icon "🗄️"},
  :ExperimentalAssay
  {:doc "A laboratory or computational measurement technique",
   :fields
   {:name
    {:type :string,
     :doc "Name of the assay",
     :examples ["RNA-seq" "ChIP-seq" "Mass spectrometry"]},
    :description {:type :string, :doc "Description of the assay"},
    :measures
    {:type :Biomolecule,
     :cardinality :many,
     :doc "Biomolecules measured by this assay"},
    :instrument
    {:type :Instrument,
     :cardinality :many,
     :doc "Instruments used in the assay"},
    :research-domain
    {:type :ResearchDomain, :doc "Primary research domain"}}},
  :Container
  {:doc "A packaged software environment image",
   :fields
   {:name
    {:type :string,
     :doc "Name of the container image",
     :examples ["biocontainers/samtools" "quay.io/biocontainers/bwa"]},
    :registry
    {:type :string,
     :doc "Container registry hosting the image",
     :examples ["Docker Hub" "Quay.io" "BioContainers"]},
    :tag
    {:type :string,
     :doc "Image tag or version",
     :examples ["latest" "1.15.1" "v2.0"]},
    :container-runtime
    {:type :container-runtime-enum,
     :doc "Container runtime technology"},
    :packages
    {:type :Package,
     :cardinality :many,
     :doc "Packages bundled in the container"},
    :base-image
    {:type :string,
     :doc "Base image used",
     :examples ["ubuntu:22.04" "debian:bullseye"]}},
   :icon "📦"},
  :HardwareRequirement
  {:doc "A computational resource needed to run a tool",
   :fields
   {:name
    {:type :string,
     :doc "Name of the hardware requirement",
     :examples ["Minimum RAM" "GPU" "CPU cores"]},
    :resource-type
    {:type :hardware-resource-enum, :doc "Type of hardware resource"},
    :minimum-value {:type :double, :doc "Minimum required value"},
    :recommended-value {:type :double, :doc "Recommended value"},
    :unit
    {:type :MeasurementUnit, :doc "Unit for the requirement value"}},
   :icon "🖥️"},
  :AccessMode
  {:doc "The means by which a resource is accessed",
   :fields
   {:name
    {:type :string,
     :doc "Name of the access mode",
     :unique? true,
     :examples ["REST API" "Download" "FTP"]},
    :description
    {:type :string, :doc "Description of the access mode"},
    :authentication-required?
    {:type :boolean, :doc "Whether authentication is required"}}},
  :Ontology
  {:doc "A formal controlled vocabulary with defined relationships",
   :fields
   {:name
    {:type :string,
     :doc "Name of the ontology",
     :unique? true,
     :examples
     ["Gene Ontology" "Sequence Ontology" "Human Phenotype Ontology"]},
    :acronym
    {:type :string,
     :doc "Common acronym",
     :examples ["GO" "SO" "HPO"]},
    :url {:type :string, :doc "URL of the ontology"},
    :maintained-by
    {:type :Organization,
     :doc "Organization maintaining the ontology"},
    :version {:type :string, :doc "Ontology release version"}}},
  :ReferenceGenome
  {:doc "A representative genome assembly used as a standard",
   :fields
   {:name
    {:type :string,
     :doc "Name of the reference genome assembly",
     :unique? true,
     :examples ["GRCh38" "GRCm39" "TAIR10"]},
    :organism {:type :Organism, :doc "Organism the genome belongs to"},
    :assembly-accession
    {:type :Identifier, :doc "Assembly accession identifier"},
    :release-date
    {:type :instant, :doc "Date the assembly was released"},
    :source
    {:type :Organization,
     :doc "Organization that produced the assembly"}},
   :icon "🧬"},
  :MaterialType
  {:doc "A category of physical or biological material",
   :fields
   {:name
    {:type :string,
     :doc "Name of the material type",
     :examples ["Genomic DNA" "Total RNA" "Protein lysate"]},
    :description
    {:type :string, :doc "Description of the material type"}}},
  :Protein
  {:doc "A protein molecule or product",
   :fields
   {:name
    {:type :string,
     :doc "Name of the protein",
     :examples
     ["Hemoglobin subunit beta" "Tumor protein p53" "Insulin"]},
    :uniprot-id
    {:type :Identifier, :doc "UniProt accession identifier"},
    :encoded-by {:type :Gene, :doc "Gene encoding this protein"},
    :organism {:type :Organism, :doc "Source organism"},
    :molecular-function
    {:type :MolecularFunction,
     :cardinality :many,
     :doc "Molecular functions of the protein"},
    :sequence {:type :string, :doc "Amino acid sequence"}},
   :icon "🧬"},
  :Gene
  {:doc "A unit of heredity",
   :fields
   {:symbol
    {:type :string,
     :doc "Official gene symbol",
     :examples ["TP53" "BRCA1" "EGFR"]},
    :name
    {:type :string,
     :doc "Full gene name",
     :examples ["Tumor protein p53" "BRCA1 DNA repair associated"]},
    :entrez-id {:type :Identifier, :doc "Entrez Gene identifier"},
    :organism {:type :Organism, :doc "Organism the gene belongs to"},
    :encodes
    {:type :Protein,
     :cardinality :many,
     :doc "Proteins encoded by the gene"},
    :involved-in
    {:type :BiologicalProcess,
     :cardinality :many,
     :doc "Biological processes the gene is involved in"}},
   :icon "🧬"},
  :InputSpecification
  {:doc "A description of required tool inputs",
   :fields
   {:name
    {:type :string,
     :doc "Name of the input",
     :examples ["Reference genome" "Read file" "Configuration file"]},
    :file-format
    {:type :FileFormat,
     :cardinality :many,
     :doc "Accepted file formats"},
    :data-type {:type :DataType, :doc "Type of data expected"},
    :required? {:type :boolean, :doc "Whether the input is required"},
    :description {:type :string, :doc "Description of the input"}}},
  :ResearchDomain
  {:doc "A field or subdiscipline of biology",
   :fields
   {:name
    {:type :string,
     :doc "Name of the research domain",
     :unique? true,
     :examples ["Genomics" "Proteomics" "Phylogenetics"]},
    :description {:type :string, :doc "Description of the domain"},
    :parent-domain
    {:type :ResearchDomain, :doc "Broader parent domain"}}},
  :MeasurementUnit
  {:doc "A standardized unit of measurement",
   :fields
   {:name
    {:type :string,
     :doc "Name of the unit",
     :unique? true,
     :examples ["Gigabyte" "Base pair" "Second"]},
    :symbol
    {:type :string, :doc "Unit symbol", :examples ["GB" "bp" "s"]},
    :quantity-kind
    {:type :string,
     :doc "Kind of quantity measured",
     :examples ["Memory" "Length" "Time"]}},
   :icon "📏"},
  :Package
  {:doc "A distributable software unit within a package ecosystem",
   :fields
   {:name
    {:type :string,
     :doc "Name of the package",
     :examples ["samtools" "biopython" "DESeq2"]},
    :ecosystem
    {:type :package-ecosystem-enum,
     :doc "Package management ecosystem"},
    :version {:type :SoftwareVersion, :doc "Package version"},
    :dependencies
    {:type :Dependency,
     :cardinality :many,
     :doc "Package dependencies"},
    :provides-tool
    {:type :SoftwareTool, :doc "Tool provided by this package"},
    :license {:type :License, :doc "Package license"}},
   :icon "📦"},
  :ApplicationCategory
  {:doc "A functional classification of software",
   :fields
   {:name
    {:type :string,
     :doc "Name of the application category",
     :unique? true,
     :examples
     ["Sequence alignment" "Variant calling" "Visualization"]},
    :description {:type :string, :doc "Description of the category"},
    :parent-category
    {:type :ApplicationCategory, :doc "Broader parent category"}}},
  :Database
  {:doc "A structured biological data repository",
   :fields
   {:name
    {:type :string,
     :doc "Name of the database",
     :unique? true,
     :examples ["UniProt" "GenBank" "PDB"]},
    :url {:type :string, :doc "URL of the database"},
    :data-type
    {:type :DataType, :cardinality :many, :doc "Types of data stored"},
    :maintained-by
    {:type :Organization,
     :doc "Organization maintaining the database"},
    :access-mode
    {:type :AccessMode,
     :cardinality :many,
     :doc "Available access modes"},
    :research-domain
    {:type :ResearchDomain, :doc "Primary research domain"}},
   :icon "🗃️"},
  :BiologicalProcess
  {:doc "A biological activity or pathway",
   :fields
   {:name
    {:type :string,
     :doc "Name of the biological process",
     :examples ["DNA repair" "Apoptosis" "Cell cycle"]},
    :go-id {:type :Identifier, :doc "Gene Ontology identifier"},
    :description {:type :string, :doc "Description of the process"},
    :part-of
    {:type :BiologicalProcess,
     :doc "Larger process this is part of"}}},
  :ControlledVocabulary
  {:doc "A curated set of standardized terms",
   :fields
   {:name
    {:type :string,
     :doc "Name of the controlled vocabulary",
     :unique? true,
     :examples ["MeSH" "NCIt" "EDAM"]},
    :url {:type :string, :doc "URL of the vocabulary"},
    :maintained-by
    {:type :Organization, :doc "Organization maintaining it"},
    :version {:type :string, :doc "Version of the vocabulary"}}},
  :MolecularFunction
  {:doc "A molecular-level biochemical activity",
   :fields
   {:name
    {:type :string,
     :doc "Name of the molecular function",
     :examples
     ["ATP binding" "DNA helicase activity" "Kinase activity"]},
    :go-id {:type :Identifier, :doc "Gene Ontology identifier"},
    :description {:type :string, :doc "Description of the function"}}},
  :Identifier
  {:doc "A persistent unique identifier such as DOI or accession",
   :fields
   {:value
    {:type :string,
     :doc "The identifier value",
     :examples ["10.1038/nature12345" "NC_000001.11" "P04637"]},
    :scheme
    {:type :identifier-scheme-enum,
     :doc "Identifier scheme or namespace"},
    :resolver-url
    {:type :string, :doc "URL to resolve the identifier"}},
   :icon "🆔"},
  :Pathway
  {:doc "A biological pathway or interaction network",
   :fields
   {:name
    {:type :string,
     :doc "Name of the pathway",
     :examples ["Glycolysis" "Citric acid cycle" "MAPK signaling"]},
    :pathway-id
    {:type :Identifier, :doc "Pathway database identifier"},
    :source-database
    {:type :Database, :doc "Database the pathway is from"},
    :organism
    {:type :Organism, :doc "Organism the pathway applies to"},
    :participating-genes
    {:type :Gene,
     :cardinality :many,
     :doc "Genes participating in the pathway"}}},
  :Tissue
  {:doc "A biological tissue type",
   :fields
   {:name
    {:type :string,
     :doc "Name of the tissue",
     :examples ["Liver" "Epithelium" "Blood"]},
    :organism {:type :Organism, :doc "Organism the tissue belongs to"},
    :anatomical-part
    {:type :AnatomicalPart,
     :doc "Anatomical part the tissue belongs to"},
    :uberon-id {:type :Identifier, :doc "UBERON ontology identifier"}},
   :icon "🧫"},
  :Reagent
  {:doc "A substance used in laboratory procedures",
   :fields
   {:name
    {:type :string,
     :doc "Name of the reagent",
     :examples ["Taq polymerase" "Ethanol" "SYBR Green"]},
    :material-type {:type :MaterialType, :doc "Type of material"},
    :vendor {:type :Organization, :doc "Supplier of the reagent"},
    :catalog-number {:type :string, :doc "Vendor catalog number"}},
   :icon "🧪"},
  :SoftwareTool
  {:doc
   "A computational program or application used in biological research",
   :fields
   {:programming-language
    {:type :ProgrammingLanguage,
     :cardinality :many,
     :doc "Implementation languages"},
    :maintainer
    {:type :Maintainer,
     :cardinality :many,
     :doc "Maintainers of the tool"},
    :description {:type :string, :doc "Description of the tool"},
    :repository {:type :Repository, :doc "Source code repository"},
    :algorithm
    {:type :Algorithm,
     :cardinality :many,
     :doc "Algorithms implemented"},
    :license {:type :License, :doc "Software license"},
    :homepage {:type :string, :doc "Homepage URL"},
    :name
    {:type :string,
     :doc "Name of the software tool",
     :unique? true,
     :examples ["BWA" "GATK" "Cytoscape"]},
    :publication
    {:type :Publication,
     :cardinality :many,
     :doc "Publications describing the tool"},
    :research-domain
    {:type :ResearchDomain,
     :cardinality :many,
     :doc "Applicable research domains"},
    :documentation
    {:type :Documentation,
     :cardinality :many,
     :doc "Available documentation"},
    :hardware-requirement
    {:type :HardwareRequirement,
     :cardinality :many,
     :doc "Hardware requirements"},
    :maturity-status {:type :MaturityStatus, :doc "Development stage"},
    :operating-system
    {:type :OperatingSystem,
     :cardinality :many,
     :doc "Supported operating systems"},
    :output-specification
    {:type :OutputSpecification,
     :cardinality :many,
     :doc "Output specifications"},
    :input-specification
    {:type :InputSpecification,
     :cardinality :many,
     :doc "Input specifications"},
    :developer
    {:type :Developer,
     :cardinality :many,
     :doc "Developers of the tool"},
    :application-category
    {:type :ApplicationCategory,
     :cardinality :many,
     :doc "Functional categories"},
    :version
    {:type :SoftwareVersion,
     :cardinality :many,
     :doc "Available versions"}},
   :icon "🛠️"},
  :SoftwareLibrary
  {:doc "A reusable code package or programming library",
   :extends :SoftwareTool,
   :fields
   {:api-documentation
    {:type :Documentation, :doc "API reference documentation"},
    :programming-language
    {:type :ProgrammingLanguage,
     :doc "Primary implementation language"},
    :package
    {:type :Package, :doc "Distributable package for the library"}}},
  :Specimen
  {:doc "A biological sample used in study",
   :fields
   {:name
    {:type :string,
     :doc "Name or label of the specimen",
     :examples ["Patient-001 tumor" "Control blood sample"]},
    :organism {:type :Organism, :doc "Source organism"},
    :tissue {:type :Tissue, :doc "Tissue of origin"},
    :material-type
    {:type :MaterialType, :doc "Material type of the specimen"},
    :collection-date {:type :instant, :doc "Date of collection"},
    :identifier {:type :Identifier, :doc "Specimen identifier"}},
   :icon "🧫"},
  :Tutorial
  {:doc "A guided learning resource for a tool",
   :fields
   {:title
    {:type :string,
     :doc "Title of the tutorial",
     :examples
     ["Getting Started with Bioconductor"
      "RNA-seq analysis walkthrough"]},
    :url {:type :string, :doc "URL of the tutorial"},
    :describes-tool
    {:type :SoftwareTool,
     :cardinality :many,
     :doc "Tools covered by the tutorial"},
    :author
    {:type :Author,
     :cardinality :many,
     :doc "Authors of the tutorial"},
    :difficulty-level
    {:type :difficulty-level-enum, :doc "Difficulty level"}},
   :icon "🎓"},
  :SequencingPlatform
  {:doc "A hardware technology for sequencing",
   :fields
   {:name
    {:type :string,
     :doc "Name of the sequencing platform",
     :unique? true,
     :examples
     ["Illumina NovaSeq 6000"
      "Oxford Nanopore MinION"
      "PacBio Sequel II"]},
    :manufacturer
    {:type :Organization, :doc "Manufacturer of the platform"},
    :sequencing-technology
    {:type :sequencing-technology-enum,
     :doc "Underlying sequencing technology"},
    :read-type {:type :read-type-enum, :doc "Type of reads produced"},
    :output-format
    {:type :FileFormat,
     :cardinality :many,
     :doc "Output file formats"}}},
  :Citation
  {:doc "A formal reference to a work or resource",
   :fields
   {:text {:type :string, :doc "Formatted citation text"},
    :publication {:type :Publication, :doc "Publication being cited"},
    :doi {:type :Identifier, :doc "DOI of the cited work"},
    :cited-tool {:type :SoftwareTool, :doc "Tool being cited"}},
   :icon "📑"},
  :AnalysisTask
  {:doc "A defined computational analysis objective",
   :fields
   {:name
    {:type :string,
     :doc "Name of the analysis task",
     :examples
     ["Read alignment"
      "Differential expression"
      "Variant annotation"]},
    :description {:type :string, :doc "Description of the task"},
    :input-data-type
    {:type :DataType, :cardinality :many, :doc "Input data types"},
    :output-data-type
    {:type :DataType, :cardinality :many, :doc "Output data types"},
    :performed-by
    {:type :SoftwareTool,
     :cardinality :many,
     :doc "Tools that perform the task"},
    :research-domain
    {:type :ResearchDomain, :doc "Associated research domain"}}},
  :Organism
  {:doc "A living entity or species studied",
   :fields
   {:name
    {:type :string,
     :doc "Name of the organism",
     :examples
     ["Homo sapiens"
      "Arabidopsis thaliana"
      "Saccharomyces cerevisiae"]},
    :common-name
    {:type :string,
     :doc "Common name",
     :examples ["Human" "Thale cress" "Baker's yeast"]},
    :taxon {:type :Taxon, :doc "Taxonomic classification"},
    :reference-genome
    {:type :ReferenceGenome,
     :cardinality :many,
     :doc "Reference genomes available"}},
   :icon "🦠"},
  :Dependency
  {:doc "A required external component for software to function",
   :fields
   {:name
    {:type :string,
     :doc "Name of the dependency",
     :examples ["zlib" "numpy" "Java Runtime"]},
    :depends-on-package
    {:type :Package, :doc "Package that satisfies the dependency"},
    :version-constraint
    {:type :string,
     :doc "Version constraint expression",
     :examples [">=1.2.0" "==3.9" "^2.0"]},
    :optional?
    {:type :boolean, :doc "Whether the dependency is optional"}}},
  :Community
  {:doc "A user or developer group around a tool",
   :fields
   {:name
    {:type :string,
     :doc "Name of the community",
     :examples ["Bioconductor" "Galaxy Community" "nf-core"]},
    :url {:type :string, :doc "Community homepage or forum URL"},
    :associated-tool
    {:type :SoftwareTool,
     :cardinality :many,
     :doc "Tools associated with the community"},
    :organization
    {:type :Organization, :doc "Governing organization"}},
   :icon "👥"},
  :Workflow
  {:doc "A defined sequence of computational steps or pipeline",
   :fields
   {:description {:type :string, :doc "Description of the workflow"},
    :repository
    {:type :Repository, :doc "Source repository for the workflow"},
    :license {:type :License, :doc "Workflow license"},
    :name
    {:type :string,
     :doc "Name of the workflow",
     :examples ["nf-core/rnaseq" "GATK Best Practices" "sarek"]},
    :steps
    {:type :AnalysisTask,
     :cardinality :many,
     :doc "Analysis tasks comprising the workflow"},
    :workflow-engine
    {:type :WorkflowEngine, :doc "Engine used to run the workflow"},
    :output-specification
    {:type :OutputSpecification,
     :cardinality :many,
     :doc "Workflow outputs"},
    :input-specification
    {:type :InputSpecification,
     :cardinality :many,
     :doc "Workflow inputs"},
    :tools-used
    {:type :SoftwareTool,
     :cardinality :many,
     :doc "Tools used in the workflow"}},
   :icon "🔀"},
  :Instrument
  {:doc "A laboratory or measurement device",
   :fields
   {:name
    {:type :string,
     :doc "Name of the instrument",
     :examples
     ["Thermal cycler" "Mass spectrometer" "Flow cytometer"]},
    :manufacturer
    {:type :Organization, :doc "Manufacturer of the instrument"},
    :model {:type :string, :doc "Model identifier"},
    :used-in-assay
    {:type :ExperimentalAssay,
     :cardinality :many,
     :doc "Assays the instrument is used in"}},
   :icon "🔬"},
  :SequenceType
  {:doc "A category of biological sequence data",
   :fields
   {:name
    {:type :string,
     :doc "Name of the sequence type",
     :unique? true,
     :examples ["DNA" "RNA" "Protein"]},
    :alphabet
    {:type :string,
     :doc "Character alphabet used",
     :examples ["ACGT" "ACGU" "20 amino acids"]},
    :description
    {:type :string, :doc "Description of the sequence type"}}},
  :OutputSpecification
  {:doc "A description of produced tool outputs",
   :fields
   {:name
    {:type :string,
     :doc "Name of the output",
     :examples ["Alignment file" "Variant calls" "QC report"]},
    :file-format
    {:type :FileFormat,
     :cardinality :many,
     :doc "Produced file formats"},
    :data-type {:type :DataType, :doc "Type of data produced"},
    :description {:type :string, :doc "Description of the output"}}},
  :Biomolecule
  {:doc "Any biological molecule such as DNA, RNA, metabolite",
   :fields
   {:name
    {:type :string,
     :doc "Name of the biomolecule",
     :examples ["Genomic DNA" "mRNA" "Glucose"]},
    :molecule-type
    {:type :biomolecule-type-enum, :doc "Category of biomolecule"},
    :sequence-type
    {:type :SequenceType,
     :doc "Associated sequence type if applicable"},
    :identifier {:type :Identifier, :doc "Database identifier"}}},
  :Publication
  {:doc "A scholarly article describing or citing a tool",
   :fields
   {:title
    {:type :string,
     :doc "Title of the publication",
     :examples ["The Sequence Alignment/Map format and SAMtools"]},
    :authors
    {:type :Author,
     :cardinality :many,
     :doc "Authors of the publication"},
    :journal
